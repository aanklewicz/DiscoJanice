default_platform(:ios)

PROJECT = "DiscoJanice.xcodeproj"
SCHEME  = "DiscoJanice"

platform :ios do
  desc "Build DiscoJanice and submit it to the App Store for review"
  lane :release do
    # Authenticate to App Store Connect with an API key (no Apple ID / 2FA needed).
    # The .p8 key contents are passed base64-encoded to avoid newline mangling in secrets.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )

    # Read the marketing version straight from the project so the App Store version
    # always matches CURRENT MARKETING_VERSION (we keep the committed build number).
    version = get_version_number(xcodeproj: PROJECT, target: SCHEME)

    # Archive and export an App Store .ipa. Signing is done by Xcode's automatic
    # signing + cloud-managed profiles (-allowProvisioningUpdates), authenticated with
    # the same API key; the distribution certificate is imported by the CI workflow.
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "DiscoJanice.ipa",
      clean: true,
      api_key: api_key,
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}"
    )

    # Upload the binary and submit for review. Metadata and screenshots are managed
    # by hand in App Store Connect, so they are skipped here — make sure the version
    # listing (release notes, etc.) is prepared before running this lane.
    upload_to_app_store(
      api_key: api_key,
      app_version: version,
      skip_screenshots: true,
      skip_metadata: true,
      skip_binary_upload: false,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end
end
